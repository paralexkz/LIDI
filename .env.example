# Copy this file to .env:
#   cp .env.example .env
#
# .env is git-ignored — nothing here gets committed.
#
# LIDI defaults to Ollama running on your own machine, which needs no API key
# and costs nothing. In that case you can leave this file untouched.

# OPTIONAL — pick the model. Format is provider/name.
# Default: ollama/llama3.1
# LIDI_MODEL=ollama/llama3.2
# LIDI_MODEL=openai/gpt-4o-mini
# LIDI_MODEL=anthropic/claude-sonnet-4-5

# OPTIONAL — where your Ollama server listens. Default: http://localhost:11434
# LIDI_OLLAMA_HOST=http://localhost:11434

# ---------------------------------------------------------------------------
# Only needed if you switch LIDI_MODEL to a hosted provider. Set the one that
# matches your provider; the others can stay empty.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MISTRAL_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=

# OPTIONAL — use a specific Chromium instead of auto-detecting one.
# Only needed if `uv run playwright install chromium` cannot run on your machine.
# LIDI_CHROMIUM_PATH=/usr/bin/chromium
