# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# .env is git-ignored — your key never gets committed.

# REQUIRED — your OpenAI API key, from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OPTIONAL — override the model. Format is provider/name.
# Default: openai/gpt-4o-mini
# LIDI_MODEL=openai/gpt-4o

# OPTIONAL — use a specific Chromium instead of auto-detecting one.
# Only needed if `uv run playwright install chromium` cannot run on your machine.
# LIDI_CHROMIUM_PATH=/usr/bin/chromium
